    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a record's data came from.\n\n``endpoint`` is the method and route template as documented by the provider, e.g.\n``GET /api/clients/{clientId}/legals/{legalId}/employees/{employeeId}``. ``locator`` is a\nJSON Pointer to the record inside that response body (\"\" means the whole body). Together\nwith the run's input (the source file, or a retained response) it locates the raw value;\non its own it does not hold the value.",
      "properties": {
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TaxEntity": {
      "additionalProperties": false,
      "description": "A legal employer identity (EIN). The id is built from the provider's own id for the\nentity (UKG ein id, isolved legal id, PrismHR client id), never from the EIN, which\nPrismHR masks. The EIN is sensitive (D-044): masked by default like personal identifiers.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "ein": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ein",
          "x-sensitive": true
        },
