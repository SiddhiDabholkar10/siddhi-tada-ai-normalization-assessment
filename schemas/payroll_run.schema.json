{
  "$defs": {
    "Coded_PayrollRunStatus_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/PayrollRunStatus"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[PayrollRunStatus]",
      "type": "object"
    },
    "Coded_PayrollRunType_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/PayrollRunType"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[PayrollRunType]",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "One finding about a record.\n\n``field`` is a path within the record (``deductions[2].category``); null means the finding\nis about the whole record. ``evidence`` cites a decision id or spec pointer; null means\nnone applies. These nulls are part of the type's meaning, so Diagnostic is a value type\nand is not subject to the field_status rule.",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticCode": {
      "enum": [
        "unknown_code",
        "inferred_mapping",
        "value_redacted_in_source",
        "sentinel_date",
        "empty_via_404",
        "source_unavailable",
        "unparseable_value",
        "reconciliation_mismatch",
        "reconciliation_incomplete",
        "conflicting_sources",
        "unit_unverified",
        "deprecated_source",
        "unvalidated_source",
        "unstable_id",
        "reference_only"
      ],
      "title": "DiagnosticCode",
      "type": "string"
    },
    "JsonValue": {},
    "MappingBasis": {
      "description": "What a canonical code value rests on.",
      "enum": [
        "documented",
        "evidenced",
        "inferred",
        "configured",
        "unmapped"
      ],
      "title": "MappingBasis",
      "type": "string"
    },
    "PayPeriod": {
      "additionalProperties": false,
      "description": "The period a run pays for one pay group. A PrismHR batch can cover several pay groups,\neach with its own period (15 of 1,813 sampled batches).",
      "properties": {
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "pay_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay Group Id"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "period_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pay period sequence number as sent (isolved payPeriod).",
          "title": "Period Number"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        }
      },
      "title": "PayPeriod",
      "type": "object"
    },
    "PayrollRunStatus": {
      "description": "Run status as the provider states it. Only completed and finalized describe processed\npay; open means calculated but not finalized (UKG, D-030) and is never read as issued.",
      "enum": [
        "not_processed",
        "new",
        "open",
        "closed",
        "submitted",
        "completed",
        "finalized",
        "failed",
        "unknown"
      ],
      "title": "PayrollRunStatus",
      "type": "string"
    },
    "PayrollRunType": {
      "enum": [
        "scheduled",
        "regular",
        "special",
        "supplemental",
        "adjustment",
        "reversal",
        "void",
        "manual",
        "correction",
        "historical",
        "conversion",
        "unknown"
      ],
      "title": "PayrollRunType",
      "type": "string"
    },
    "Provider": {
      "enum": [
        "prismhr",
        "isolved",
        "ukg-ready"
      ],
      "title": "Provider",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a record's data came from.\n\n``endpoint`` is the method and route template as documented by the provider, e.g.\n``GET /api/clients/{clientId}/legals/{legalId}/employees/{employeeId}``. ``locator`` is a\nJSON Pointer to the record inside that response body (\"\" means the whole body). Together\nwith the run's input (the source file, or a retained response) it locates the raw value;\non its own it does not hold the value.",
      "properties": {
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "ValueStatus": {
      "description": "Why a field is null. A field holding a value is \"present\" and is not listed.",
      "enum": [
        "hidden_by_source",
        "not_provided",
        "not_applicable"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "$id": "payroll_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "title": "Company Id",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "field_status": {
      "additionalProperties": {
        "$ref": "#/$defs/ValueStatus"
      },
      "description": "Why each null field in this object is null. Lists null fields only.",
      "title": "Field Status",
      "type": "object"
    },
    "finalized_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalized Date"
    },
    "id": {
      "description": "Canonical id: provider:tenant:entity:source ids (see ids.py).",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider's description of the run, as sent.",
      "title": "Name"
    },
    "pay_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pay Date"
    },
    "pay_periods": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/PayPeriod"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pay Periods"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Provider-specific fields with no canonical meaning, keyed by source field path. Never used for anything the brief lists for the four data types (D-037).",
      "title": "Provider Extensions",
      "type": "object"
    },
    "run_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Date"
    },
    "run_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Run sequence number (isolved runNumber); joins checks to runs.",
      "title": "Run Number"
    },
    "run_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coded_PayrollRunType_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheduled_pay_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled Pay Date"
    },
    "sensitive_provider_extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Like provider_extensions, for provider-specific data that is sensitive (e.g. PrismHR health screening results). Masked as a whole by default in output (D-036).",
      "title": "Sensitive Provider Extensions",
      "type": "object",
      "x-sensitive": true
    },
    "source_ids": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "description": "The provider's own identifiers needed to address this record, by provider field name.",
      "minProperties": 1,
      "title": "Source Ids",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coded_PayrollRunStatus_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tax_entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tax Entity Id"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "provider",
    "tenant_id",
    "source_ids",
    "sources",
    "company_id"
  ],
  "title": "PayrollRun",
  "type": "object"
}
