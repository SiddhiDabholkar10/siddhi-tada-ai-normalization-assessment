    "DeductionCategory": {
      "description": "Purpose of a deduction. Tax treatment is a separate dimension (TaxTreatment).",
      "enum": [
        "benefit",
        "retirement",
        "retirement_loan",
        "loan",
        "garnishment",
        "flexible_spending",
        "health_savings",
        "voluntary",
        "unknown"
      ],
      "title": "DeductionCategory",
      "type": "string"
    },
    "DeductionLine": {
      "additionalProperties": false,
      "description": "An employee deduction taken in this payroll. Classification is inherited from the\ncompany deduction code (D-047). Garnishments are deduction lines with category garnishment.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_DeductionCategory_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deduction_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's code, id and name as sent."
        },
        "deduction_code_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deduction Code Id"
        },
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "is_catch_up": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Catch Up"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Benefit plan the deduction is for (PrismHR planId)."
        },
        "source_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's id for the line, as sent (isolved, UKG). A UKG tax line split into employee and employer sides keeps the same id on both.",
          "title": "Source Line Id"
        },
        "tax_treatment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_TaxTreatment_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DeductionLine",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "One finding about a record.\n\n``field`` is a path within the record (``deductions[2].category``); null means the finding\nis about the whole record. ``evidence`` cites a decision id or spec pointer; null means\nnone applies. These nulls are part of the type's meaning, so Diagnostic is a value type\nand is not subject to the field_status rule.",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticCode": {
      "enum": [
        "unknown_code",
        "inferred_mapping",
        "value_redacted_in_source",
        "sentinel_date",
        "empty_via_404",
        "source_unavailable",
        "unparseable_value",
        "reconciliation_mismatch",
        "reconciliation_incomplete",
        "conflicting_sources",
        "unit_unverified",
        "deprecated_source",
        "unvalidated_source",
        "unstable_id",
        "reference_only"
      ],
      "title": "DiagnosticCode",
      "type": "string"
    },
    "EarningClass": {
      "description": "What an earning is (PrismHR payClass). Cash vs non-cash is a separate flag (is_cash),\nbecause class alone does not decide it (PrismHR TAXREF is memo and cash, D-023).",
      "enum": [
        "wages",
        "reimbursement",
        "non_cash_fringe",
        "reported_tips",
        "memo",
        "unknown"
      ],
      "title": "EarningClass",
      "type": "string"
    },
    "EarningLine": {
      "additionalProperties": false,
      "description": "One earning. ``hours`` holds a quantity only when it is documented or verified as hours\n(PrismHR pay codes with payReason H, UKG milliseconds per D-028); a unit count goes in\n``units``. ``amount`` is the line total (PrismHR payAmount, despite its spec description,\nD-051).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "earning_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's code, id and name as sent."
        },
        "earning_code_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earning Code Id"
        },
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "hours": {
          "anyOf": [
            {
              "description": "Duration in decimal hours.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hours paid.",
          "title": "Hours"
        },
        "hours_worked": {
          "anyOf": [
            {
              "description": "Duration in decimal hours.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hours Worked"
        },
        "is_cash": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Cash"
        },
        "pay_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_EarningClass_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rate per hour or unit.",
          "title": "Rate"
        },
        "rate_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_RateClass_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's id for the line, as sent (isolved, UKG). A UKG tax line split into employee and employer sides keeps the same id on both.",
          "title": "Source Line Id"
        },
        "units": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Units paid, for unit-based pay codes.",
          "title": "Units"
        }
      },
      "title": "EarningLine",
      "type": "object"
    },
    "EmployerContributionLine": {
      "additionalProperties": false,
      "description": "An amount the employer pays toward a plan. Sources: PrismHR employerContributions, UKG\ndeduction er_amount (linked to that deduction code), isolved memo earnings whose label is\nin the mapping table (inferred, D-055). Retirement employer amounts are not repeated here:\nthey stay in the non-additive retirement breakdown.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "deduction_code_id": {
          "anyOf": [
            {
