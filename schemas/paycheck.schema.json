          "title": "Field Status",
          "type": "object"
        },
        "match_eligible_wages": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Eligible Wages"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "premium_amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premium Amount"
        },
        "premium_cost": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premium Cost"
        }
      },
      "title": "BenefitLine",
      "type": "object"
    },
