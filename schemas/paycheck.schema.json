            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Deduction"
        },
        "employer_contribution": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
