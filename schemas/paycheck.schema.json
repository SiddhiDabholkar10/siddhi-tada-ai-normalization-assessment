        },
        "earning_code_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "isolved: the memo earning code it came from.",
          "title": "Earning Code Id"
        },
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plan or code the contribution is for, as sent."
        },
        "source_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's id for the line, as sent (isolved, UKG). A UKG tax line split into employee and employer sides keeps the same id on both.",
          "title": "Source Line Id"
        }
      },
      "title": "EmployerContributionLine",
      "type": "object"
    },
    "JsonValue": {},
    "MappingBasis": {
      "description": "What a canonical code value rests on.",
      "enum": [
        "documented",
        "evidenced",
        "inferred",
        "configured",
        "unmapped"
      ],
      "title": "MappingBasis",
      "type": "string"
    },
    "PaidBy": {
      "description": "Who bears a tax line. Comes from the source structure (PrismHR employeeTax vs companyTax,\nisolved isEmployeeTax, UKG ee_amount vs er_amount), not from a code.",
      "enum": [
        "employee",
        "employer",
        "unknown"
      ],
      "title": "PaidBy",
      "type": "string"
    },
    "PaycheckKind": {
      "description": "Kind of paycheck (PrismHR voucher type, isolved check type). Reversal is not a kind: it is\nmarked on the paycheck (D-033).",
      "enum": [
        "regular",
        "supplemental",
        "vacation",
        "adjustment",
        "arrears",
        "manual",
        "unknown"
      ],
      "title": "PaycheckKind",
      "type": "string"
    },
    "PaycheckStatus": {
      "enum": [
        "printed",
        "new",
        "open",
        "closed",
        "finalized",
        "invalid",
        "unknown"
      ],
      "title": "PaycheckStatus",
      "type": "string"
    },
    "PaymentLine": {
      "additionalProperties": false,
      "description": "How net pay was delivered. ``method`` keeps the provider's label (UKG type_name) or, where\nthe method comes from the source structure, the source field name. Non-cash lines (UKG\n\"Fringe\") are kept as information and are not part of net pay.",
      "properties": {
        "account_last4": {
          "anyOf": [
            {
              "description": "Visible last characters of a masked value (D-020).",
              "pattern": "^.{1,4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Last4"
        },
