{
  "$defs": {
    "BenefitLine": {
      "additionalProperties": false,
      "description": "A benefit plan row as the provider reports it for this paycheck (PrismHR benefit[],\nisolved benefits[]). Informational and not additive: its amounts repeat deduction and\nemployer contribution lines, and isolved also lists non-contribution rows here (D-051).",
      "properties": {
        "adjustment_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjustment Ref"
        },
        "catch_up_amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catch Up Amount"
        },
        "coverage_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coverage period as sent (PrismHR '202508').",
          "title": "Coverage Period"
        },
        "eligible_wages": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligible Wages"
        },
        "employee_contribution": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Contribution"
        },
        "employee_deduction": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
