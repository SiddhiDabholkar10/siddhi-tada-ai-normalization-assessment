{
  "$defs": {
    "BenefitPlanDetail": {
      "additionalProperties": false,
      "properties": {
        "amount_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_RatePeriod_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coverage_amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Amount"
        },
        "coverage_basis_amount": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Basis Amount"
        },
        "coverage_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coded_CoverageLevel_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependent_premium": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependent Premium"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "employee_contribution": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Contribution"
        },
        "employee_premium": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Premium"
        },
        "employee_premium_contribution": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Premium Contribution"
        },
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "provider_contribution": {
          "anyOf": [
            {
              "description": "Money amount in the record's `currency`.",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Contribution"
        }
      },
      "title": "BenefitPlanDetail",
      "type": "object"
    },
    "BenefitType": {
      "enum": [
        "medical",
        "dental",
        "vision",
        "life",
        "short_term_disability",
        "long_term_disability",
        "unknown"
      ],
      "title": "BenefitType",
      "type": "string"
    },
    "Coded_BenefitType_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/BenefitType"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[BenefitType]",
      "type": "object"
    },
    "Coded_CoverageLevel_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/CoverageLevel"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[CoverageLevel]",
      "type": "object"
    },
    "Coded_EnrollmentStatus_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/EnrollmentStatus"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[EnrollmentStatus]",
      "type": "object"
    },
    "Coded_RatePeriod_": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MappingBasis"
        },
        "raw_code": {
          "title": "Raw Code",
          "type": "string"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Label"
        },
        "value": {
          "$ref": "#/$defs/RatePeriod"
        }
      },
      "required": [
        "value",
        "raw_code",
        "basis"
      ],
      "title": "Coded[RatePeriod]",
      "type": "object"
    },
    "CoverageLevel": {
      "enum": [
        "employee_only",
        "employee_spouse",
        "employee_children",
        "family",
        "unknown"
      ],
      "title": "CoverageLevel",
      "type": "string"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "One finding about a record.\n\n``field`` is a path within the record (``deductions[2].category``); null means the finding\nis about the whole record. ``evidence`` cites a decision id or spec pointer; null means\nnone applies. These nulls are part of the type's meaning, so Diagnostic is a value type\nand is not subject to the field_status rule.",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticCode": {
      "enum": [
        "unknown_code",
        "inferred_mapping",
        "value_redacted_in_source",
        "sentinel_date",
        "empty_via_404",
        "source_unavailable",
        "unparseable_value",
        "reconciliation_mismatch",
        "reconciliation_incomplete",
        "conflicting_sources",
        "unit_unverified",
        "deprecated_source",
        "unvalidated_source",
        "unstable_id",
        "reference_only"
      ],
      "title": "DiagnosticCode",
      "type": "string"
    },
    "EnrollmentStatus": {
      "enum": [
        "eligible_unenrolled",
        "active",
        "terminated",
        "cobra",
        "waived",
        "unknown"
      ],
      "title": "EnrollmentStatus",
      "type": "string"
    },
    "JsonValue": {},
    "MappingBasis": {
      "description": "What a canonical code value rests on.",
      "enum": [
        "documented",
        "evidenced",
        "inferred",
        "configured",
        "unmapped"
      ],
      "title": "MappingBasis",
      "type": "string"
    },
    "Provider": {
      "enum": [
        "prismhr",
        "isolved",
        "ukg-ready"
      ],
      "title": "Provider",
      "type": "string"
    },
    "RatePeriod": {
      "description": "The period an amount or a number of hours refers to (per hour, per year, ...).",
      "enum": [
        "hour",
        "day",
        "week",
        "pay_period",
        "month",
        "year",
        "unknown"
      ],
      "title": "RatePeriod",
      "type": "string"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A provider code-table entry referred to by a record (a job, a pay code, a parent\norganization): the provider's id, code and name, whichever the source gives.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "field_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueStatus"
          },
          "description": "Why each null field in this object is null. Lists null fields only.",
          "title": "Field Status",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "title": "Reference",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a record's data came from.\n\n``endpoint`` is the method and route template as documented by the provider, e.g.\n``GET /api/clients/{clientId}/legals/{legalId}/employees/{employeeId}``. ``locator`` is a\nJSON Pointer to the record inside that response body (\"\" means the whole body). Together\nwith the run's input (the source file, or a retained response) it locates the raw value;\non its own it does not hold the value.",
      "properties": {
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "ValueStatus": {
      "description": "Why a field is null. A field holding a value is \"present\" and is not listed.",
      "enum": [
        "hidden_by_source",
        "not_provided",
        "not_applicable"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "$id": "benefit_enrollment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benefit_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coded_BenefitType_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "company_id": {
      "title": "Company Id",
      "type": "string"
    },
    "coverage_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage End"
    },
    "coverage_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coded_CoverageLevel_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage Start"
    },
    "currency": {
      "anyOf": [
        {
          "description": "ISO 4217 currency code.",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "deduction_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deduction End"
    },
    "deduction_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deduction Start"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "employee_id": {
      "title": "Employee Id",
      "type": "string"
    },
    "field_status": {
      "additionalProperties": {
        "$ref": "#/$defs/ValueStatus"
      },
      "description": "Why each null field in this object is null. Lists null fields only.",
      "title": "Field Status",
      "type": "object"
    },
    "id": {
      "description": "Canonical id: provider:tenant:entity:source ids (see ids.py).",
      "title": "Id",
      "type": "string"
    },
    "is_section_125": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Section 125"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_details": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/BenefitPlanDetail"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Details"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Provider-specific fields with no canonical meaning, keyed by source field path. Never used for anything the brief lists for the four data types (D-037).",
      "title": "Provider Extensions",
      "type": "object"
    },
    "sensitive_provider_extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Like provider_extensions, for provider-specific data that is sensitive (e.g. PrismHR health screening results). Masked as a whole by default in output (D-036).",
      "title": "Sensitive Provider Extensions",
      "type": "object",
      "x-sensitive": true
    },
    "source_ids": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "description": "The provider's own identifiers needed to address this record, by provider field name.",
      "minProperties": 1,
      "title": "Source Ids",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coded_EnrollmentStatus_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "waive_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waive Reason"
    }
  },
  "required": [
    "id",
    "provider",
    "tenant_id",
    "source_ids",
    "sources",
    "company_id",
    "employee_id"
  ],
  "title": "BenefitEnrollment",
  "type": "object"
}
