{
  "provider": "ukg-ready",
  "entity": "company",
  "notes": [
    "One company per sign-in company_id; there is no company resource (D-029), so legal_name, display_name, company_code, status, status_date, address, phone and parent are null with not_provided and the company carries a source_unavailable diagnostic.",
    "Tax entities come from lookup/eins plus the EINs referenced by payrolls and employees (D-029, D-094): one per EIN id. lookup/eins wins when it lists the id; an id it omits (live: the 2nd EIN, named by 24 payrolls and 13 employees, absent from lookup/eins and lookup/profile-specific/eins) is built from the payroll list's ein object, else the employee detail's ein_name, with a reference_only diagnostic. The ids themselves are the reference rows of the payroll and employee tables.",
    "Work locations: no source. config/cost-centers has a documented location_code, but it was empty on 71 of 71 cost centers (D-065); work_locations is null with not_provided.",
    "Deduction and earning codes carry no type (D-031): category, tax_treatment, calc_method, pay_class, rate_class and quantity_type are null with not_provided unless a tenant mapping is configured; is_cash, is_catch_up, w2 fields and is_active likewise."
  ],
  "fields": [
    {"route": "/v2/companies/{cid}/lookup/eins", "field": "items[].id", "use": "mapped", "target": "Company.tax_entities[].id", "transform": "reference", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__eins.html", "D-042"], "note": "Canonical tax entity id from the UKG ein id, never from the EIN."},
    {"route": "/v2/companies/{cid}/lookup/eins", "field": "items[].ein_name", "use": "mapped", "target": "Company.tax_entities[].name", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__eins.html", "live: 'Primary EIN' (1 of 1)"]},
    {"route": "/v2/companies/{cid}/lookup/eins", "field": "items[].ein_tax_id", "use": "mapped", "target": "Company.tax_entities[].ein", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__eins.html", "D-029", "D-044"], "note": "Returned in full (format-only check, D-029 correction); sensitive, masked in output by default."},
    {"route": "/v2/companies/{cid}/lookup/eins", "field": "items[].ein_country_id", "use": "mapped", "target": "Company.tax_entities[].country", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__eins.html", "live: 'USA' (1 of 1)"]},
    {"route": "/v2/companies/{cid}/payrolls", "field": "payrolls[].ein.ein_name", "use": "mapped", "target": "Company.tax_entities[].name", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__payrolls.html", "D-029", "D-094"], "note": "Only for an EIN id lookup/eins does not list (reference_only); first payroll in list order."},
    {"route": "/v2/companies/{cid}/payrolls", "field": "payrolls[].ein.ein_tax_id", "use": "mapped", "target": "Company.tax_entities[].ein", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__payrolls.html", "D-029", "D-044", "D-094"], "note": "Only for an EIN id lookup/eins does not list; returned in full (D-029 correction), sensitive, masked by default."},
    {"route": "/v2/companies/{cid}/payrolls", "field": "payrolls[].ein.ein_country_id", "use": "mapped", "target": "Company.tax_entities[].country", "transform": "copy", "live_only": true, "evidence": ["live: not in the documented schema", "D-094"], "note": "Only for an EIN id lookup/eins does not list."},
    {"route": "/v2/companies/{cid}/employees/{aid}", "field": "ein_name", "use": "mapped", "target": "Company.tax_entities[].name", "transform": "copy", "live_only": true, "evidence": ["live: sent beside ein.id (3 of 3 sampled details)", "D-094"], "note": "Only for an EIN id that neither lookup/eins nor a payroll names; the detail sends no tax id or country, so those stay null."},
    {"route": "/v2/companies/{cid}/lookup/eins", "field": "items[].ein_currency_code", "use": "extension", "target": "Company.tax_entities[].provider_extensions", "reason": "Currency setting of the EIN; tax entities hold no money (D-036). Absent in 1 of 1.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__eins.html"]},

    {"route": "/v2/companies/{cid}/lookup/deduction-codes", "field": "items[].id", "use": "mapped", "target": "Company.deduction_codes[].id", "transform": "reference", "live_only": true, "evidence": ["live: id on 43 of 43 codes; not in the documented schema"], "note": "Canonical id from the UKG code id. Pay statement deduction lines refer to codes by this id (payroll table, live-only deduction.id)."},
    {"route": "/v2/companies/{cid}/lookup/deduction-codes", "field": "items[].code", "use": "mapped", "target": "Company.deduction_codes[].code", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__deduction-codes.html"]},
    {"route": "/v2/companies/{cid}/lookup/deduction-codes", "field": "items[].name", "use": "mapped", "target": "Company.deduction_codes[].name", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__deduction-codes.html"]},
    {"route": "/v2/companies/{cid}/lookup/deduction-codes", "field": "items[].external_id", "use": "extension", "target": "Company.deduction_codes[].provider_extensions", "reason": "Integration id of the code (10 of 43); no canonical meaning.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__deduction-codes.html"]},

    {"route": "/v2/companies/{cid}/lookup/earning-codes", "field": "items[].id", "use": "mapped", "target": "Company.earning_codes[].id", "transform": "reference", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__earning-codes.html"]},
    {"route": "/v2/companies/{cid}/lookup/earning-codes", "field": "items[].code", "use": "mapped", "target": "Company.earning_codes[].code", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__earning-codes.html"]},
    {"route": "/v2/companies/{cid}/lookup/earning-codes", "field": "items[].name", "use": "mapped", "target": "Company.earning_codes[].name", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__earning-codes.html"]},
    {"route": "/v2/companies/{cid}/lookup/earning-codes", "field": "items[].external_id", "use": "extension", "target": "Company.earning_codes[].provider_extensions", "reason": "Integration id of the code (9 of 52); no canonical meaning.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__earning-codes.html"]},

    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].id", "use": "mapped", "target": "Company.pay_groups[].id", "transform": "reference", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html", "D-065"], "note": "One pay group per pay period profile. Employees link through profiles.pay_period[].id (step 3)."},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].name", "use": "mapped", "target": "Company.pay_groups[].name", "transform": "copy", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"], "note": "Profiles have no code: pay_groups[].code is null with not_provided."},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].active", "use": "mapped", "target": "Company.pay_groups[].is_active", "transform": "boolean", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"]},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].period_type.type", "use": "mapped", "target": "Company.pay_groups[].pay_frequency", "transform": "code:ukg-ready.period_type", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html", "D-041"], "note": "Raw code is the type, except every_n_weeks and every_n_days, whose raw codes are 'every_n_weeks:<num_weeks>' and 'every_n_days:<num_days>'."},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].period_type.params.num_weeks", "use": "mapped", "target": "Company.pay_groups[].pay_frequency", "transform": "derive", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html", "D-041"], "note": "Part of the raw code for every_n_weeks (see period_type.type)."},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].period_type.params.num_days", "use": "mapped", "target": "Company.pay_groups[].pay_frequency", "transform": "derive", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"], "note": "Part of the raw code for every_n_days (see period_type.type)."},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].period_type.params.*", "use": "extension", "target": "Company.pay_groups[].provider_extensions", "reason": "Schedule parameters (start dates, pay days, week day); the frequency is typed.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"]},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].description", "use": "extension", "target": "Company.pay_groups[].provider_extensions", "reason": "Free-text description next to the name (7 of 12).", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"]},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].effective_from", "use": "extension", "target": "Company.pay_groups[].provider_extensions", "reason": "Validity window of the profile; PayGroup has no dates.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"]},
    {"route": "/v2/companies/{cid}/lookup/pay-period-profiles", "field": "items[].effective_to", "use": "extension", "target": "Company.pay_groups[].provider_extensions", "reason": "Validity window of the profile; PayGroup has no dates.", "evidence": ["contracts/ukg-ready/reference-docs/res/__v2__companies__(cid)__lookup__pay-period-profiles.html"]},
